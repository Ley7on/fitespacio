# FitSpace Environment Configuration
# Copy this file to .env and update with your actual values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,fitspaceonfire.c14csmaqqepi.us-east-2.rds.amazonaws.com

# Database Configuration - AWS RDS PostgreSQL
DB_NAME=fitspace
DB_USER=desoxi
DB_PASSWORD=desoxi2613.
DB_HOST=fitspaceonfire.c14csmaqqepi.us-east-2.rds.amazonaws.com
DB_PORT=5432

# Security Settings
SESSION_COOKIE_AGE=3600
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# AWS Settings (if using S3 for static files)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket
AWS_S3_REGION_NAME=us-east-2

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Monitoring
HEALTH_CHECK_ENABLED=True
METRICS_ENABLED=True

# ISO Compliance
AUDIT_ENABLED=True
SECURITY_MONITORING=True
QUALITY_METRICS=True